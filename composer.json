{
    "name": "everfrost/core",
    "description": "Shared domain primitives and models for the Everfrost ecosystem.",
    "type": "library",
    "license": "MPL-2.0",
    "keywords": [
        "everfrost",
        "domain",
        "domain-model",
        "infrastructure",
        "capabilities"
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Everfrost\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Everfrost\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@lint"
        ]
    },
    "config": {
        "sort-packages": true
    }
}